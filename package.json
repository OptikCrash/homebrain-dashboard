{
  "name": "homebrain-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backend": "docker compose up --build",
    "backend:homebrain": "docker compose -f docker-compose.yml -f docker-compose.homebrain.yml up --build",
    "frontend": "npm --prefix web start",
    "all": "sh scripts/dev-all.sh",
    "all:homebrain": "sh scripts/dev-all.sh -f docker-compose.yml -f docker-compose.homebrain.yml",
    "test": "node --test scripts/*.test.mjs"
  }
}
