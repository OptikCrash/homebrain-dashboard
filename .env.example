# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Host port the dashboard is exposed on.
DASHBOARD_PORT=8090

# Existing host directory containing builder .pid and .log files (mounted read-only).
BUILDER_LOGS_DIR=/opt/data/work/logs

# Postgres credentials for the compose `postgres` service.
POSTGRES_USER=homebrain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homebrain
