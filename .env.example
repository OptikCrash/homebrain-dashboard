# Copy to .env and fill in real values. .env is gitignored; never commit it.

# Host-network loopback ports: web 8080 (separate #90), API 8090,
# dashboard Postgres 5434; 5433 belongs to the builders' devdb.
# Direct API runs may set PORT; Compose fixes it to 8090.
PORT=8090

# Postgres credentials for the compose `postgres` service.
POSTGRES_USER=homebrain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homebrain

# Host directory containing roles.json and <Name>-<N>.json, mounted read-only.
# Home Brain: TEAM_STATUS_DIR=/srv/homebrain/hermes-dev/work/logs/status
# Outside Docker, TEAM_STATUS_DIR is the reader path (default /logs/status).
TEAM_STATUS_DIR=./logs/status

# Host directory of cron-written backup.json, chopper.json and ap5.json,
# mounted read-only at /srv/homebrain/status. No secrets live here.
# Outside Docker, HOST_STATUS_DIR is the reader path (default /srv/homebrain/status).
HOST_STATUS_DIR=/srv/homebrain/status

# Postgres connection string for running the API, Prisma CLI (`npm run db:migrate`)
# or the database tests outside Docker. Prisma doesn't read this root .env: export
# it in your shell, or put it in api/.env (also gitignored). Inside Docker,
# docker-compose.yml builds DATABASE_URL from the POSTGRES_* values above.
# Compose connects via 127.0.0.1:5434 (5433 is reserved for dev).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5434/DATABASE

# Syncthing REST health reader. Supply the API key from Syncthing's GUI settings.
# Host networking reaches loopback services directly.
SYNCTHING_URL=http://127.0.0.1:8384
SYNCTHING_API_KEY=
# Comma-separated folder IDs; empty means only system/connection checks.
SYNCTHING_FOLDERS=

# Delay between completed Syncthing polls, in milliseconds (positive integer).
SYNCTHING_POLL_INTERVAL_MS=30000

# CouchDB reachability only: unauthenticated GET /_up (404 falls back to /).
# HTTP 200 or 401 means reachable. Never supply CouchDB credentials.
# Default Compose host networking reaches this loopback listener.
COUCHDB_URL=http://127.0.0.1:5984

# Delay between completed CouchDB polls, in milliseconds (positive integer).
COUCHDB_POLL_INTERVAL_MS=30000

# Delay between completed backup file polls, in milliseconds (positive integer).
BACKUP_POLL_INTERVAL_MS=30000
